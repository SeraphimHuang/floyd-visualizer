  "mode": "exchange",
  "directed": true,
  "nodes": [
    { "id": "🐱", "label": "Cat Coin",   "x": 0,     "y": -1 },
    { "id": "🐶", "label": "Dog Coin",   "x": 0.95,  "y": -0.31 },
    { "id": "🦆", "label": "Duck Coin",  "x": 0.59,  "y": 0.81 },
    { "id": "🐰", "label": "Bunny Coin", "x": -0.59, "y": 0.81 },
    { "id": "🐼", "label": "Panda Coin", "x": -0.95, "y": -0.31 }
  ],
  "edges": [
    { "from": "🐱", "to": "🐶", "rate": 1.19 },
    { "from": "🐶", "to": "🐱", "rate": 0.76 },
    { "from": "🐶", "to": "🦆", "rate": 0.61 },
    { "from": "🦆", "to": "🐶", "rate": 1.48 },
    { "from": "🦆", "to": "🐰", "rate": 2.38 },
    { "from": "🐰", "to": "🦆", "rate": 0.37 },
    { "from": "🐰", "to": "🐼", "rate": 0.24 },
    { "from": "🐼", "to": "🐰", "rate": 3.8 },
