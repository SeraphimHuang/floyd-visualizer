    { "from": "🐱", "to": "🐼", "rate": 0.48 },
    { "from": "🦆", "to": "🐱", "rate": 1.45 }
  ],
  "scenarios": [
    {
      "name": "Fix the Duck price",
      "description": "🦆 → 🐱 back to a fair 1.19: the arbitrage disappears.",
      "addEdges": [{ "from": "🦆", "to": "🐱", "rate": 1.19 }]
    },
    {
      "name": "Panda pump",
      "description": "The Duck price is fixed, but 🐼 → 🐱 jumps to 2.2: the arbitrage moves to a new loop.",
      "addEdges": [
        { "from": "🦆", "to": "🐱", "rate": 1.19 },
        { "from": "🐼", "to": "🐱", "rate": 2.2 }
      ]
    }
  ]
